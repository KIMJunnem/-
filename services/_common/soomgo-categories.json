    {
      "name": "사업계획서 작성",
      "match": "^사업계획서\\s*작성$"
    },
    {
      "name": "데이터 크롤링",
      "match": "^데이터\\s*크롤링$"
    },
    {
      "name": "데이터 가공 및 라벨링",
      "match": "^데이터\\s*가공\\s*및\\s*라벨링$"
    }
  ],
  "_changes": [
    {
