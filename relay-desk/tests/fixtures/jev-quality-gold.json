  "edit_pairs": [
    { "id": "ep-01", "original": "회의는 내일 오후 3시에 열릴 예정 입니다.", "edited": "회의는 내일 오후 3시에 열릴 예정입니다.", "gold": { "original_had_error": true, "meaning_changed": false } },
