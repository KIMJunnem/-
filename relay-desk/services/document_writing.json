  "soomgoCategories": [
    {
      "name": "문서/글 작성",
      "match": "^문서\\s*[/·]?\\s*글\\s*작성$"
    },
    {
      "name": "교정/교열",
      "match": "^교정\\s*[/·]?\\s*교열$",
      "foreignLanguage": {
        "action": "auto_rules",
        "reason": "외국어 교정 — 영어는 영어 교정 단가로 자동 견적, 그 외 언어는 자동 삭제",
        "languageFields": [
          "작성\\s*언어",
          "문서\\s*언어",
          "언어"
        ],
        "koreanValues": "한국어|한글|국문|korean",
        "foreignHints": "영문|영어|english|외국어|일본어|일문|중국어|중문|japanese|chinese"
      }
    },
    {
      "name": "속기(타이핑)",
      "match": "^속기\\s*(?:\\(\\s*타이핑\\s*\\)|[/·]?\\s*타이핑)?$"
    },
    {
      "name": "보고서",
      "match": "^보고서$"
    },
    {
      "name": "대본/시나리오",
      "match": "^대본\\s*[/·]?\\s*시나리오$",
      "_note": "2026-09-23 준희 결정: 판매. 대본·시나리오는 자동 견적하지 않고 견적 판단 알림으로 준희가 가격을 정한다(scriptRequest)."
    }
  ],
