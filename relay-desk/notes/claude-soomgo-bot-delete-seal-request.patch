+  // 숨고 요청 상세 화면의 '삭제하기'를 누르고, 가운데 확인 팝업의 삭제
+  // 버튼까지 누른다. 버튼을 찾지 못하면 false를 돌려주고 삭제를 가정하지 않는다.
+  async function deleteCurrentRequest() {
+    const notBot = el => !el.closest('#relay-soomgo-v3');
+    const label = el => clean(el.textContent || el.getAttribute('aria-label') || '');
+    const deleteButton = [...document.querySelectorAll('button,[role=button],a')]
+      .filter(notBot).filter(visible)
+      .find(el => /^삭제하기$/.test(label(el)));
+    if (!deleteButton) return false;
+    try { deleteButton.click(); } catch (_) { return false; }
+    await new Promise(resolve => setTimeout(resolve, 400));
+    const dialogs = [...document.querySelectorAll('[role="dialog"], [aria-modal="true"], .modal, [class*="Modal"]')]
+      .filter(notBot).filter(visible);
+    const scope = dialogs[dialogs.length - 1] || null;
+    if (!scope) return false;
+    const confirm = [...scope.querySelectorAll('button,[role=button],a')]
+      .filter(notBot).filter(visible)
+      .filter(el => /^(삭제|삭제하기|확인|네|예)$/.test(label(el)))
+      .pop();
+    if (!confirm || confirm === deleteButton) return false;
+    try { confirm.click(); } catch (_) { return false; }
+    await new Promise(resolve => setTimeout(resolve, 600));
+    return true;
+  }
